<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.1.0</VersionPrefix>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestorePackagesPath>$(MSBuildThisFileDirectory)artifacts\nuget</RestorePackagesPath>
    <UseSonnetDbSource Condition="'$(UseSonnetDbSource)' == ''">false</UseSonnetDbSource>
    <SonnetDbSourceProject Condition="'$(SonnetDbSourceProject)' == ''">$(MSBuildThisFileDirectory)..\SonnetDB\src\SonnetDB.Core\SonnetDB.Core.csproj</SonnetDbSourceProject>
    <BaseIntermediateOutputPath Condition="'$(UseSonnetDbSource)' == 'true'">$(MSBuildThisFileDirectory)artifacts\obj\sonnetdb-source\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="'$(UseSonnetDbSource)' == 'true'">$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <BaseOutputPath Condition="'$(UseSonnetDbSource)' == 'true'">$(MSBuildThisFileDirectory)artifacts\bin\sonnetdb-source\$(MSBuildProjectName)\</BaseOutputPath>
    <DefaultItemExcludes Condition="'$(UseSonnetDbSource)' == 'true'">$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
    <NuGetLockFilePath Condition="'$(UseSonnetDbSource)' == 'true'">$(MSBuildProjectExtensionsPath)packages.lock.json</NuGetLockFilePath>
    <NuGetLockFilePath Condition="'$(UseSonnetDbSource)' != 'true' and '$(CoupletPublishAot)' == 'true'">$(MSBuildProjectDirectory)\obj\packages.aot.$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <DefineConstants Condition="'$(UseSonnetDbSource)' == 'true'">$(DefineConstants);COUPLET_SONNETDB_SOURCE_GENERATIONS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Couplet.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://couplet.dev/contracts/indexing/v1/schema.json",
  "schema_version": "couplet.indexing.v1",
  "description": "Couplet C1 workspace discovery, parsed snapshot, incremental plan, SonnetDB staging document, and staging report contracts.",
  "$defs": {
    "workspace_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "length", "disposition", "reason", "language", "text_only", "is_symlink"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "length": { "type": "integer", "minimum": 0 },
        "content_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "disposition": { "enum": ["Included", "Ignored", "Denied", "Binary", "Generated", "SymlinkOutside", "Unreadable"] },
        "reason": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "text_only": { "type": "boolean" },
        "is_symlink": { "type": "boolean" }
      }
    },
    "workspace_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "repository_identity", "worktree_identity", "source_revision", "is_dirty", "files"],
      "properties": {
        "schema_version": { "const": "couplet.workspace_discovery.v1" },
        "workspace_id": { "type": "string", "pattern": "^cpl_workspace_" },
        "repository_identity": { "type": "string", "minLength": 1 },
        "worktree_identity": { "type": "string", "minLength": 1 },
        "branch": { "type": ["string", "null"] },
        "head_revision": { "type": ["string", "null"] },
        "source_revision": { "type": "string", "minLength": 1 },
        "is_dirty": { "type": "boolean" },
        "files": { "type": "array", "items": { "$ref": "#/$defs/workspace_file" } }
      }
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "start_column", "start_byte", "end_line", "end_column", "end_byte"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "start_line": { "type": "integer", "minimum": 1 },
        "start_column": { "type": "integer", "minimum": 1 },
        "start_byte": { "type": "integer", "minimum": 0 },
        "end_line": { "type": "integer", "minimum": 1 },
        "end_column": { "type": "integer", "minimum": 1 },
        "end_byte": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "source_revision", "index_revision", "adapter_id", "adapter_version", "content_hash"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "index_revision": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "score", "rule"],
      "properties": {
        "kind": { "enum": ["Exact", "Inferred", "Unknown"] },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rule": { "type": "string", "minLength": 1 }
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "display_name", "qualified_identity", "signature", "language", "definition", "provenance", "confidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^cpl_" },
        "kind": { "enum": ["Workspace", "Repository", "Project", "BuildTarget", "Module", "Namespace", "File", "Type", "Member", "Symbol", "Test", "Chunk"] },
        "display_name": { "type": "string", "minLength": 1 },
        "qualified_identity": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 },
        "container_id": { "type": ["string", "null"] },
        "language": { "type": "string", "minLength": 1 },
        "definition": { "$ref": "#/$defs/source_span" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file_id", "ordinal", "content_hash", "content", "span"],
      "properties": {
        "id": { "type": "string", "pattern": "^cpl_chunk_" },
        "file_id": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content": { "type": "string" },
        "span": { "$ref": "#/$defs/source_span" },
        "symbol_id": { "type": ["string", "null"] }
      }
    },
    "indexed_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "content_hash", "length", "language", "semantic_tier", "adapter_id", "adapter_version", "symbols", "chunks"],
      "properties": {
        "id": { "type": "string", "pattern": "^cpl_file_" },
        "path": { "type": "string", "minLength": 1 },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "length": { "type": "integer", "minimum": 0 },
        "language": { "type": "string", "minLength": 1 },
        "semantic_tier": { "enum": ["Exact", "Partial", "TextOnly", "Unsupported"] },
        "adapter_id": { "type": "string", "minLength": 1 },
        "adapter_version": { "type": "string", "minLength": 1 },
        "symbols": { "type": "array", "items": { "$ref": "#/$defs/symbol" } },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/chunk" } }
      }
    },
    "file_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "adapter_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "adapter_id": { "type": "string", "minLength": 1 }
      }
    },
    "workspace_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "source_revision", "index_revision", "producer_versions", "files", "failures"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "repository_identity": { "type": ["string", "null"] },
        "worktree_identity": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "head_revision": { "type": ["string", "null"] },
        "source_revision": { "type": "string", "minLength": 1 },
        "index_revision": { "type": "string", "minLength": 1 },
        "previous_index_revision": { "type": ["string", "null"] },
        "producer_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "files": { "type": "array", "items": { "$ref": "#/$defs/indexed_file" } },
        "failures": { "type": "array", "items": { "$ref": "#/$defs/file_failure" } }
      }
    },
    "file_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["Added", "Modified", "Deleted", "Renamed", "Unchanged"] },
        "path": { "type": ["string", "null"] },
        "previous_path": { "type": ["string", "null"] },
        "content_hash": { "type": ["string", "null"] }
      }
    },
    "incremental_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspace_id", "source_revision", "index_revision", "changes", "rebuild_required"],
      "properties": {
        "workspace_id": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "index_revision": { "type": "string", "minLength": 1 },
        "previous_index_revision": { "type": ["string", "null"] },
        "changes": { "type": "array", "items": { "$ref": "#/$defs/file_change" } },
        "rebuild_required": { "type": "boolean" },
        "rebuild_reason": { "type": ["string", "null"] }
      }
    },
    "generation_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "symbols", "chunks", "full_text_documents", "vectors", "graph_nodes", "graph_edges"],
      "properties": {
        "files": { "type": "integer", "minimum": 0 },
        "symbols": { "type": "integer", "minimum": 0 },
        "chunks": { "type": "integer", "minimum": 0 },
        "full_text_documents": { "type": "integer", "minimum": 0 },
        "vectors": { "type": "integer", "minimum": 0 },
        "graph_nodes": { "type": "integer", "minimum": 0 },
        "graph_edges": { "type": "integer", "minimum": 0 }
      }
    },
    "generation_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "source_revision", "index_revision", "code_graph_schema_version", "producer_versions", "counts", "checksum", "state", "created_at_utc"],
      "properties": {
        "schema_version": { "const": "couplet.generation.v1" },
        "workspace_id": { "type": "string", "minLength": 1 },
        "source_revision": { "type": "string", "minLength": 1 },
        "index_revision": { "type": "string", "minLength": 1 },
        "previous_index_revision": { "type": ["string", "null"] },
        "code_graph_schema_version": { "const": "couplet.code_graph.v1" },
        "producer_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "counts": { "$ref": "#/$defs/generation_counts" },
        "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "state": { "const": "Staging" },
        "created_at_utc": { "type": "string", "format": "date-time" }
      }
    },
    "stage_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest", "collection_name", "staged", "published", "problems"],
      "properties": {
        "schema_version": { "const": "couplet.index_stage.v1" },
        "manifest": { "$ref": "#/$defs/generation_manifest" },
        "collection_name": { "type": "string", "pattern": "^cplg_[0-9a-f]{32}$" },
        "staged": { "type": "boolean" },
        "published": { "const": false },
        "blocking_gap": { "const": "CG-005" },
        "limitations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "problems": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "staging_inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "workspace_id", "index_revision", "collection_name", "complete", "problems"],
      "properties": {
        "schema_version": { "const": "couplet.staging_inspection.v1" },
        "workspace_id": { "type": "string", "minLength": 1 },
        "index_revision": { "type": "string", "minLength": 1 },
        "collection_name": { "type": "string", "pattern": "^cplg_[0-9a-f]{32}$" },
        "manifest": { "oneOf": [{ "$ref": "#/$defs/generation_manifest" }, { "type": "null" }] },
        "complete": { "type": "boolean" },
        "problems": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "c1_corpus_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale", "generator_version", "files", "lines_of_code", "declared_symbols", "corpus_hash"],
      "properties": {
        "scale": { "enum": ["medium", "large"] },
        "generator_version": { "type": "string", "minLength": 1 },
        "files": { "type": "integer", "minimum": 1 },
        "lines_of_code": { "type": "integer", "minimum": 1 },
        "declared_symbols": { "type": "integer", "minimum": 1 },
        "corpus_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "c1_capacity_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "temperature", "samples", "p50_milliseconds", "p95_milliseconds", "p99_milliseconds", "allocated_bytes", "peak_working_set_bytes", "storage_growth_bytes", "access_path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "temperature": { "enum": ["cold", "warm"] },
        "samples": { "type": "integer", "minimum": 1 },
        "p50_milliseconds": { "type": "number", "minimum": 0 },
        "p95_milliseconds": { "type": "number", "minimum": 0 },
        "p99_milliseconds": { "type": "number", "minimum": 0 },
        "throughput_per_second": { "type": ["number", "null"], "minimum": 0 },
        "allocated_bytes": { "type": "integer", "minimum": 0 },
        "peak_working_set_bytes": { "type": "integer", "minimum": 0 },
        "storage_growth_bytes": { "type": "integer", "minimum": 0 },
        "access_path": { "type": "string", "minLength": 1 },
        "candidates": { "type": ["integer", "null"], "minimum": 0 },
        "examined": { "type": ["integer", "null"], "minimum": 0 },
        "returned": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "c1_capacity_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "logical_cores", "available_memory_bytes", "operating_system", "runtime", "execution_mode", "file_system", "storage", "power_profile", "background_load"],
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "physical_cores": { "type": ["integer", "null"], "minimum": 1 },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "available_memory_bytes": { "type": "integer", "minimum": 1 },
        "operating_system": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "execution_mode": { "enum": ["jit", "native_aot"] },
        "file_system": { "type": "string", "minLength": 1 },
        "storage": { "type": "string", "minLength": 1 },
        "power_profile": { "type": "string", "minLength": 1 },
        "background_load": { "type": "string", "minLength": 1 }
      }
    },
    "c1_capacity_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "commit", "corpus_manifest_hash", "corpus", "environment", "initial_counts", "incremental_counts", "modified_files", "database_bytes", "published", "correctness_recovery_passed", "performance_capacity_passed", "metrics", "problems", "generated_at_utc"],
      "properties": {
        "schema_version": { "const": "couplet.c1_capacity_evidence.v1" },
        "commit": { "type": "string", "minLength": 1 },
        "corpus_manifest_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "corpus": { "$ref": "#/$defs/c1_corpus_generation" },
        "environment": { "$ref": "#/$defs/c1_capacity_environment" },
        "initial_counts": { "$ref": "#/$defs/generation_counts" },
        "incremental_counts": { "$ref": "#/$defs/generation_counts" },
        "modified_files": { "const": 100 },
        "database_bytes": { "type": "integer", "minimum": 0 },
        "published": { "const": false },
        "correctness_recovery_passed": { "const": false },
        "performance_capacity_passed": { "const": false },
        "metrics": { "type": "array", "minItems": 10, "items": { "$ref": "#/$defs/c1_capacity_metric" } },
        "problems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "generated_at_utc": { "type": "string", "format": "date-time" }
      }
    }
  }
}

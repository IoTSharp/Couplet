<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\SonnetDB.props" />

  <PropertyGroup>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" />
    <PackageReference Include="System.Numerics.Tensors" />
    <ProjectReference Include="..\Couplet.Application\Couplet.Application.csproj" />
    <ProjectReference Include="..\Couplet.Core\Couplet.Core.csproj" />
    <ProjectReference Include="$(SonnetDbSourceProject)"
                      SetConfiguration="Configuration=$(Configuration)"
                      AdditionalProperties="Configuration=$(Configuration);BaseOutputPath=$(SonnetDbBuildRoot)bin/;BaseIntermediateOutputPath=$(SonnetDbBuildRoot)obj/;MSBuildProjectExtensionsPath=$(SonnetDbBuildRoot)obj/;JiebaDictionaryCompilerOutput=$(SonnetDbBuildRoot)dictionary/compiler/;JiebaDictionaryDat=$(SonnetDbBuildRoot)dictionary/dict.dat;DefaultItemExcludes=$(SonnetDbSourceRoot)/src/SonnetDB.Core/bin/**%3B$(SonnetDbSourceRoot)/src/SonnetDB.Core/obj/**" />
  </ItemGroup>

  <!-- NuGet's restore graph ignores ProjectReference AdditionalProperties. Remove only
       during graph discovery, then restore the pinned source project into Couplet artifacts. -->
  <Target Name="ExcludeSonnetDbSourceFromCoupletRestoreGraph"
          BeforeTargets="_GenerateRestoreProjectPathItemsPerFramework;_GenerateProjectRestoreGraphPerFramework">
    <ItemGroup>
      <ProjectReference Remove="$(SonnetDbSourceProject)" />
    </ItemGroup>
  </Target>

  <Target Name="RestoreSonnetDbSourceDependency"
          BeforeTargets="ResolveProjectReferences"
          DependsOnTargets="ValidateSonnetDbSourceDependency;PrepareSonnetDbDictionaryOutput">
    <MSBuild Projects="$(SonnetDbSourceProject)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);BaseOutputPath=$(SonnetDbBuildRoot)bin/;BaseIntermediateOutputPath=$(SonnetDbBuildRoot)obj/;MSBuildProjectExtensionsPath=$(SonnetDbBuildRoot)obj/;JiebaDictionaryCompilerOutput=$(SonnetDbBuildRoot)dictionary/compiler/;JiebaDictionaryDat=$(SonnetDbBuildRoot)dictionary/dict.dat;DefaultItemExcludes=$(SonnetDbSourceRoot)/src/SonnetDB.Core/bin/**%3B$(SonnetDbSourceRoot)/src/SonnetDB.Core/obj/**;RestorePackagesWithLockFile=false" />
  </Target>

  <Target Name="PrepareSonnetDbDictionaryOutput">
    <PropertyGroup>
      <_SonnetDbCommittedDictionary>$(SonnetDbSourceRoot)\src\SonnetDB.Core\FullText\Tokenizers\Jieba\Resources\Generated\dict.dat</_SonnetDbCommittedDictionary>
      <_SonnetDbIsolatedDictionary>$(SonnetDbBuildRoot)dictionary\dict.dat</_SonnetDbIsolatedDictionary>
    </PropertyGroup>
    <Error Condition="!Exists('$(_SonnetDbCommittedDictionary)')"
           Text="The pinned SonnetDB source is missing its committed Jieba dictionary." />
    <MakeDir Directories="$(SonnetDbBuildRoot)dictionary" />
    <Copy SourceFiles="$(_SonnetDbCommittedDictionary)"
          DestinationFiles="$(_SonnetDbIsolatedDictionary)"
          SkipUnchangedFiles="true" />
    <Touch Files="$(_SonnetDbIsolatedDictionary)" AlwaysCreate="true" />
  </Target>

  <Target Name="ValidateSonnetDbSourceDependency" BeforeTargets="ResolveProjectReferences">
    <Error Condition="!Exists('$(SonnetDbSourceProject)')"
           Text="SonnetDB source project was not found at '$(SonnetDbSourceProject)'. CPL-007 currently requires the canonical sibling repository." />
    <Exec Command="git -C &quot;$(SonnetDbSourceRoot)&quot; rev-parse HEAD"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SonnetDbSourceCommitOutput" />
    </Exec>
    <PropertyGroup>
      <_ActualSonnetDbSourceCommit>@(_SonnetDbSourceCommitOutput)</_ActualSonnetDbSourceCommit>
    </PropertyGroup>
    <Error Condition="'$(_ActualSonnetDbSourceCommit)' != '$(SonnetDbSourceCommit)'"
           Text="SonnetDB source commit '$(_ActualSonnetDbSourceCommit)' does not match the CPL-007 pin '$(SonnetDbSourceCommit)'. Update the pin and spike evidence deliberately." />
    <Exec Command="git -C &quot;$(SonnetDbSourceRoot)&quot; status --porcelain --untracked-files=all -- src/SonnetDB.Core Directory.Build.props"
          ConsoleToMSBuild="true"
          StandardOutputImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_SonnetDbRelevantSourceStatus" />
    </Exec>
    <Error Condition="'@(_SonnetDbRelevantSourceStatus)' != ''"
           Text="The pinned SonnetDB Core source or build policy has uncommitted changes. Commit and update the pin before building Couplet." />
    <XmlPeek XmlInputPath="$(SonnetDbSourceRoot)\Directory.Packages.props"
             Query="/Project/ItemGroup/PackageVersion[@Include='System.IO.Hashing']/@Version">
      <Output TaskParameter="Result" PropertyName="_SonnetDbHashingVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(SonnetDbSourceRoot)\Directory.Packages.props"
             Query="/Project/ItemGroup/PackageVersion[@Include='System.Numerics.Tensors']/@Version">
      <Output TaskParameter="Result" PropertyName="_SonnetDbTensorsVersion" />
    </XmlPeek>
    <Error Condition="'$(_SonnetDbHashingVersion)' != '10.0.10'"
           Text="Pinned SonnetDB source requires System.IO.Hashing '$(_SonnetDbHashingVersion)', but CPL-007 is locked to '10.0.10'." />
    <Error Condition="'$(_SonnetDbTensorsVersion)' != '10.0.10'"
           Text="Pinned SonnetDB source requires System.Numerics.Tensors '$(_SonnetDbTensorsVersion)', but CPL-007 is locked to '10.0.10'." />
  </Target>
</Project>
